# Copy to .env and fill in. Only the first four are required to boot.
# Schema of record: packages/env/src/server.ts

# --- Required ---

# PostgreSQL connection string (Supabase or any Postgres).
DATABASE_URL=postgresql://user:password@localhost:5432/opendiagram

# Session signing secret, 32+ characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where the API is reachable.
BETTER_AUTH_URL=http://localhost:3000

# Allowed browser origin (the web app).
CORS_ORIGIN=http://localhost:3001

# --- AI providers ---

# Platform default model. Needed for diagram generation unless every user
# supplies their own key. Get one: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# BYOK: base64-encoded 32-byte key encrypting user API keys at rest.
# Generate: openssl rand -base64 32
# BYOK settings are disabled when this is unset.
BYOK_ENCRYPTION_KEY=

# Optional intent classifier. Falls back to regex when unset.
GROQ_API_KEY=

# Optional OpenAI-compatible gateway. Unused by default.
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=

# --- Optional ---

# GitHub OAuth, for repo import and social login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Production split deploys only: shared parent domain (e.g. ".example.com")
# so the session cookie works across app.* and api.*. Leave unset locally.
COOKIE_DOMAIN=

# Project memory backend.
COGNEE_BASE_URL=
COGNEE_API_KEY=

# Fraction of traces sampled, 0..1. Defaults to 1.
SENTRY_TRACES_SAMPLE_RATE=1
