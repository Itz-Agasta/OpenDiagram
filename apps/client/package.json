{
  "name": "client",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build-blog": "bun run ./scripts/build-blog-data.ts",
    "prebuild": "bun run build-blog",
    "dev": "bun run build-blog && dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3002\"",
    "generate-routes": "tsr generate",
    "build": "bun run build-blog && vite build && cp instrument.server.mjs dist/server",
    "preview": "bun run build && vite preview",
    "test": "vitest run",
    "check-types": "tsgo --noEmit",
    "deploy": "bun run build && wrangler deploy",
    "start": "node --import ./dist/server/instrument.server.mjs dist/server/index.js",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@OpenDiagram/harness": "workspace:*",
    "@ai-sdk/react": "^4.0.69",
    "@cloudflare/kumo": "^2.8.0",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@sentry/tanstackstart-react": "^10.42.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "ai": "^7.0.66",
    "better-auth": "^1.6.25",
    "dotenv-cli": "^11.0.0",
    "evlog": "^2.25.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "idb-keyval": "^6.3.0",
    "js-yaml": "^5.3.0",
    "lenis": "^1.3.25",
    "lucide-react": "^0.545.0",
    "motion": "^12.42.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "typescript": "catalog:",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.114.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
