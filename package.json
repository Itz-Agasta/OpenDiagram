{
  "name": "OpenDiagram",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^18.0.8",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "@milkdown/crepe": "7.22.3",
      "@milkdown/kit": "7.22.3",
      "@types/lodash.throttle": "^4.1.9",
      "better-auth": "1.7.11",
      "drizzle-orm": "^0.45.1",
      "evlog": "^2.19.2",
      "lodash.throttle": "^4.1.1",
      "lucide-react": "^1.21.0",
      "pg": "^8.22.0",
      "motion": "^12.42.2",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "zustand": "^5.0.14",
      "@tailwindcss/postcss": "^4.3.1",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.1",
      "ai": "^7.0.10",
      "next": "16.4.2",
      "fumadocs-core": "16.17.7",
      "fumadocs-ui": "16.17.7",
      "remark": "15.0.1",
      "remark-gfm": "4.0.1",
      "remark-rehype": "11.1.2",
      "hast-util-to-jsx-runtime": "2.3.6",
      "class-variance-authority": "^0.7.1",
      "@ai-sdk/react": "^4.0.5",
      "@openrouter/ai-sdk-provider": "^3.0.0",
      "elkjs": "^0.12.0",
      "@types/node": "^26.6.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:generate": "turbo run db:generate -F @OpenDiagram/db",
    "db:migrate": "turbo run db:migrate -F @OpenDiagram/db",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "oxlint && oxfmt --write",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@OpenDiagram/config": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "latest",
    "knip": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "latest",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
