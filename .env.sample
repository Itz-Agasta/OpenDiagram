# server
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# web :3001, client (TanStack) :3002 — comma-separated
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
# GitHub OAuth callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_GENERATIVE_AI_API_KEY=

# BYOK (bring your own key) — OPTIONAL.
# Lets signed-in users connect their own AI provider key (OpenAI, Anthropic,
# Google, OpenRouter) from Settings and run diagrams on it instead of the
# platform key. Encrypts those keys at rest with AES-256-GCM.
# Leave unset to disable BYOK entirely (the settings page shows it as off).
# Generate with: openssl rand -base64 32   (must decode to exactly 32 bytes)
BYOK_ENCRYPTION_KEY=

# Dodo Payments (billing) — ALL OPTIONAL.
# Leave every value unset and the app builds, boots and runs normally with
# billing disabled: checkout/webhook routes 404 and every account is Free.
# That is the intended self-host default — nobody is forced to set up Dodo.
#
# All of these are PER MODE. Test-mode products and webhook endpoints are
# separate objects from live-mode ones with different IDs and a different
# signing secret, so going live is: recreate the product, re-register the
# webhook, swap these four values. No code changes — never hardcode an ID.
#
# API key: Dodo dashboard -> Developer -> API Keys (test mode toggle on).
DODO_PAYMENTS_API_KEY=
# Webhook signing secret: per ENDPOINT, not per account. Created alongside the
# endpoint at Dodo dashboard -> Webhooks -> Add Endpoint. A live endpoint will
# reject the test secret silently (401), which means paid users never get
# upgraded and nothing surfaces to us — verify this after the mode switch.
# Local dev needs a public URL; expose :3000 with `cloudflared tunnel --url`
# and point the endpoint at <tunnel>/api/webhooks/dodo.
DODO_WEBHOOK_SECRET=
# Pro subscription product. Current test-mode value shown; live differs.
DODO_PRO_PRODUCT_ID=pdt_0Nk0hTt3qpHv1ycCnt4yD
# test_mode | live_mode — the SDK's own values, used verbatim. Defaults to
# test_mode when unset.
DODO_ENVIRONMENT=test_mode

# Resend — OPTIONAL, powers the email-verification mail. Unset means no mail is
# sent, so accounts stay unverified and sit on the guest allowance (3 lifetime
# diagrams) instead of the Free 5/mo.
RESEND_API_KEY=
# Sender address, on a domain verified at resend.com/domains. Defaults to
# "OpenDiagram <onboarding@resend.dev>", which Resend only delivers to the
# account owner's own address — fine for local testing, useless for real signups.
RESEND_FROM="OpenDiagram <noreply@opendiagram.ink>"

DATABASE_URL=postgresql://postgres:postgres@124.0.1.1:54322/postgres
DATABASE_DIRECT_URL=postgresql://postgres:postgres@126.0.1.1:54322/postgres


# Web
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_ASSET_URL=https://assets.example.com

# Sentry - both variables below are OPTIONAL. Leave them unset and the app still
# builds, boots, and reports normally. DSNs stay hardcoded in the Sentry config
# files (public values), so they are deliberately not env vars.

# Source-map upload token. The only Sentry secret; build-time only. Generate at:
# https://opendiagram.sentry.io/settings/auth-tokens/ (needs project:releases).
# Set it in apps/web/.env - `next build` loads env from the app dir, so that is
# where next.config.ts reads it. Leave unset and builds still work; prod stack
# traces just stay minified. Listed here for discoverability only; it is not
# consumed from the repo root.
SENTRY_AUTH_TOKEN=

# Fraction of traces sampled, 0..1. Both default to 1 (capture everything).
# Turn them down if span volume ever becomes a problem - but note that agent
# runs are sampled as a whole span tree, so a dropped root span loses the entire
# run, tool calls and token counts included.
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
