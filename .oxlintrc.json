{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // Since 1.79 a bare `_` param is reported unless argsIgnorePattern is set
    // explicitly, and setting options drops the `^_` vars default. We use
    // `{ key: _, ...rest }` to drop a key from a copy.
    // https://github.com/oxc-project/oxc/pull/25663
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }]
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["apps/web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@OpenDiagram/harness",
                "message": "Client code must not import runtime values from the harness barrel. Use `import type` or the lightweight subpath @OpenDiagram/harness/diagram-schema.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    }
  ]
}
